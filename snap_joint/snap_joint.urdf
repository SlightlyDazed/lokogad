<?xml version="1.0" encoding="UTF-8"?>
<robot name="snap_pin_joint" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ============ Materials ============ -->
  <material name="pla_white">
    <color rgba="0.95 0.95 0.95 1.0"/>
  </material>
  <material name="pla_blue">
    <color rgba="0.2 0.4 0.8 1.0"/>
  </material>

  <!-- ============ Link A (con pin) ============ -->
  <link name="link_A">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="link_A.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="pla_white"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="link_A.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.01"/>
      <origin xyz="0.0300 0 0.0020" rpy="0 0 0"/>
      <inertia ixx="6.13e-07" ixy="0" ixz="0"
               iyy="3.01e-06" iyz="0" izz="3.49e-06"/>
    </inertial>
  </link>

  <!-- ============ Link B (con agujero) ============ -->
  <link name="link_B">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="link_B.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="pla_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="link_B.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.01"/>
      <origin xyz="0.0300 0 0.0020" rpy="0 0 0"/>
      <inertia ixx="6.13e-07" ixy="0" ixz="0"
               iyy="3.01e-06" iyz="0" izz="3.49e-06"/>
    </inertial>
  </link>

  <!-- ============ Joint revolute ============ -->
  <joint name="snap_pin" type="revolute">
    <parent link="link_A"/>
    <child link="link_B"/>
    <origin xyz="0.0540 0 0.0040" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.570796" upper="1.570796"
           effort="1.0" velocity="3.14"/>
    <dynamics damping="0.001" friction="0.005"/>
  </joint>

</robot>
